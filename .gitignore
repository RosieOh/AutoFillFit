# 워크스페이스별 .gitignore(server/ web/ mobile/)가 각자의 빌드 산출물을 다룬다.
# 이 파일은 저장소 전체에 걸리는 것과, 거기서 빠진 것만 담는다.

# ---------------------------------------------------------------- 비밀 값
# server/.gitignore는 .env를 막지만 web/은 .env.local만 막는다.
# 여기서 전부 막고 예시 파일만 되살린다 — 한 번 커밋되면 히스토리에서 지우기 어렵다.
.env
.env.*
!.env.example
!.env.*.example

# 검증용으로 만들었다가 남는 것들
*.token
*.pem
*.key

# ---------------------------------------------------------------- 의존성·빌드
node_modules/
dist/
build/
.next/
out/
.expo/
web-build/
*.tsbuildinfo

# ---------------------------------------------------------------- 테스트
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------------------------------------------------------------- 로그·임시
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
*.tmp
*.orig
*.bak

# ---------------------------------------------------------------- 도구·에디터
.vscode/
.idea/
*.swp

# Claude Code의 개인 설정. 공유용 .claude/settings.json은 커밋한다.
.claude/settings.local.json

# ---------------------------------------------------------------- OS
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 확장 프로그램
# content.js·manifest.json·styles.css는 빌드 없이 그대로 로드하므로 전부 커밋한다.
# 배포용 압축본만 제외한다.
*.zip
*.crx
