# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=autofill_fit
# 개발 환경에서만 true 권장 (운영은 migration 사용)
DB_SYNCHRONIZE=true

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS (콤마 구분, Chrome Extension origin 포함) ---
CORS_ORIGINS=chrome-extension://<YOUR_EXTENSION_ID>,http://localhost:3000
