# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=autofill_fit
# 스키마는 마이그레이션으로만 바꾼다. NODE_ENV=production이면 이 값과 무관하게 꺼진다.
#   npm run migration:generate -- src/database/migrations/<이름>
#   npm run migration:run
DB_SYNCHRONIZE=false
# SQL 로그. 생략하면 개발에서만 켜진다.
DB_LOGGING=true

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS (콤마 구분, Chrome Extension origin 포함) ---
CORS_ORIGINS=chrome-extension://<YOUR_EXTENSION_ID>,http://localhost:3000

# --- 메일 (비밀번호 재설정) ---
# 없으면 메일을 보내지 않고 재설정 링크를 로그에 남긴다.
SMTP_URL=
MAIL_FROM=AutoFill-Fit <no-reply@example.com>

# 메일에 넣을 링크의 출처. 운영에서는 반드시 설정할 것 —
# 비우면 요청 헤더의 Origin을 쓰므로 공격자 도메인이 들어갈 수 있다.
WEB_ORIGIN=http://localhost:3000
